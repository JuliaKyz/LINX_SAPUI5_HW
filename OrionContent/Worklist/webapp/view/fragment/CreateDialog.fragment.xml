<c:FragmentDefinition
xmlns="sap.m"
xmlns:c="sap.ui.core"
>
	<Dialog 
	class="sapUiContentPadding"
	beforeOpen="onDialogBeforeOpen" 
	title="{i18n>CreateDialogTitle}">
	 <content>
      <VBox>
        <VBox>
          <Label text="{i18n>DocumentNumber}" labelFor="idDocumentNumber" />
          <Input
            value="{DocumentNumber}"
            id="idDocumentNumber"
          />
        </VBox>
        <VBox>
          <Label text="{i18n>DocumentDate}" labelFor="idDocumentDate" />
          <DatePicker
            id="idDocumentDate"
            value="{
              'path':'DocumentDate',
              'type':'sap.ui.model.type.Date',
              'formatOptions': {
                'pattern': 'yyyy-MM-dd'
              }
            }"
            change="handleChange"
            class="sapUiSmallMarginBottom"/>
        </VBox>
        <VBox>
          <Label text="{i18n>Description}" labelFor="idDescription" />
          <TextArea
            rows="5"
            width="100%"
            maxLength="256"
            value="{Description}"
            id="idDescription"
          />
        </VBox>
        <VBox>
          <Label text="{i18n>PlantText}" labelFor="idPlantText" />
          <Input
            value="{PlantText}"
            id="idPlantText"
          />
        </VBox>
        <VBox>
          <Label text="{i18n>RegionText}" labelFor="idRegionText" />
          <Input
            value="{RegionText}"
            id="idRegionText"
          />
        </VBox>
      </VBox>
    </content>
		
		<beginButton>
			<Button 
			type="Emphasized" 
			press = "onPressSave" 
			text="{i18n>BeginButton}"/>
		</beginButton>
		<endButton>
			<Button 
			type="Transparent"
			press = "onPressCancel"
			text="{i18n>EndButton}"/>
		</endButton>
	</Dialog>
</c:FragmentDefinition>